# PolyAlpha Protocol — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# ── Blockchain ──────────────────────────────────────────────────────────────
PRIVATE_KEY=0x_your_wallet_private_key_here
AMOY_RPC_URL=https://rpc-amoy.polygon.technology/
POLYGONSCAN_API_KEY=your_polygonscan_api_key

# ── Deployed Contract Addresses (fill after deploy) ─────────────────────────
VAULT_CONTRACT_ADDRESS=
MOCK_USDC_ADDRESS=
PALPHA_TOKEN_ADDRESS=

# ── AI Agent ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_optional
AGENT_WALLET_ADDRESS=0x_your_agent_wallet_address

# ── LLM (GLM Free v5) ───────────────────────────────────────────────────────
# Get your key from: https://open.bigmodel.cn/
LLM_API_KEY=your_glm_api_key_here

# ── Zep Memory ──────────────────────────────────────────────────────────────
# Get your key from: https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ── Telegram Alerts (pm_arb_agent.py) ───────────────────────────────────────
# Get token from @BotFather, chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Frontend (create frontend/.env separately) ──────────────────────────────
# REACT_APP_VAULT_ADDRESS=
# REACT_APP_PALPHA_ADDRESS=
