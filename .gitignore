# Environment & secrets — NEVER commit these
.env
*.env.local
*.env.*.local

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyc
venv/
.venv/
env/
agent/venv/

# Build outputs
frontend/build/
dist/
*.tgz

# Hardhat artifacts
artifacts/
cache/
typechain/
typechain-types/

# Data files (large, not for repo)
data/*.csv
data/*.json
!data/.gitkeep

# Auto-generated reports (charts, JSONL, summaries)
reports/*.jsonl
reports/*.json
reports/*.html
reports/*.png
!reports/.gitkeep

# Auto-generated swarm simulation data
frontend/public/swarm_latest.json

# OS
.DS_Store
Thumbs.db

